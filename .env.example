# Скопируй этот файл в .env и впиши свои ключи Supabase.
# .env в git НЕ коммитится (см. .gitignore). Этот .example — коммитится как шаблон.
# Это publishable/anon-ключ (можно показывать клиенту). service_role-ключ сюда НЕ класть.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
